---
import Base from "../layouts/Base.astro";
import { site, url } from "../data/site";
---

<Base title={`Page not found · ${site.name}`}>
  <section class="case">
    <h1>Page not found</h1>
    <p class="lead">This page doesn't exist, or it moved.</p>
    <p><a href={url("/")}>Go to the home page →</a></p>
  </section>
</Base>
