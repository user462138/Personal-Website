---
import { site } from "../data/site";
---

<header class="hero">
  <canvas id="field" aria-hidden="true"></canvas>
  <span class="kicker"><i></i>Software engineer · AI</span>
  <h1>{site.name}</h1>
  <p class="tagline">I build software and apply AI so people can <span class="rot" id="rot">explore more</span>.</p>
  <p class="sub">
    I design and build software, web applications, business tools and AI-powered features end to end, from the first idea
    to production. My focus is software that is reliable, secure and easy for people to use.
  </p>
  <nav class="links" aria-label="Sections">
    <a href="#work">Work</a><a href="#call">Book a call</a><a href={site.github} target="_blank" rel="noopener">GitHub ↗</a>
  </nav>
  <button type="button" class="resume-btn" data-open-resume>
    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
      <path d="M4 1.5h5.5L12.5 4.5v10h-8.5z"></path><path d="M9.5 1.5v3h3M6.5 8h4M6.5 10.5h4"></path>
    </svg>View resume
  </button>
</header>

<script>
  const reduce = window.matchMedia?.("(prefers-reduced-motion: reduce)").matches ?? false;

  /* Rotating phrase */
  const rot = document.getElementById("rot");
  const phrases = ["explore more", "find answers faster", "decide with confidence", "spend less time on busywork"];
  let pi = 0;
  if (rot && !reduce) {
    setInterval(() => {
      rot.classList.add("out");
      setTimeout(() => {
        pi = (pi + 1) % phrases.length;
        rot.textContent = phrases[pi] ?? phrases[0]!;
        rot.classList.remove("out");
      }, 350);
    }, 2800);
  }

  /* Dot field: a quiet grid that wakes up around the pointer and breathes on its own */
  const cv = document.getElementById("field") as HTMLCanvasElement | null;
  const cx = cv?.getContext("2d");
  if (cv && cx) {
    const hero = cv.parentElement!;
    const cs = getComputedStyle(document.documentElement);
    const C_DOT = cs.getPropertyValue("--muted").trim() || "#6B7078";
    const C_ACC = cs.getPropertyValue("--accent").trim() || "#2F5D50";
    const GAP = 26;
    const Z = { x0: 0, x1: 0, y0: 0, y1: 0 };
    let W = 0, H = 0, px = -999, py = -999, run = true;

    const zone = () => {
      const c = cv.getBoundingClientRect(), h = hero.getBoundingClientRect(), pad = 18;
      Z.x0 = h.left - c.left - pad; Z.x1 = h.right - c.left + pad;
      Z.y0 = h.top - c.top + 20; Z.y1 = h.bottom - c.top + pad;
    };
    const inZ = (x: number, y: number) => x > Z.x0 && x < Z.x1 && y > Z.y0 && y < Z.y1;
    const size = () => {
      const r = cv.getBoundingClientRect(), dpr = Math.min(2, window.devicePixelRatio || 1);
      W = r.width; H = r.height;
      cv.width = W * dpr; cv.height = H * dpr;
      cx.setTransform(dpr, 0, 0, dpr, 0, 0);
      zone();
    };
    const draw = (t: number) => {
      cx.clearRect(0, 0, W, H);
      const near: [number, number, number][] = [];
      const pIn = inZ(px, py);
      for (let y = GAP / 2; y < H; y += GAP) {
        for (let x = GAP / 2; x < W; x += GAP) {
          const wave = Math.pow(Math.sin(x * 0.012 + y * 0.018 - t * 0.0011) * 0.5 + 0.5, 6);
          const z = inZ(x, y), d = Math.hypot(x - px, y - py);
          const pull = pIn || z ? 0 : Math.max(0, 1 - d / 150);
          cx.globalAlpha = (0.16 + wave * 0.28 + pull * 0.6) * (z ? 0.35 : 1);
          cx.fillStyle = pull > 0.05 ? C_ACC : C_DOT;
          cx.beginPath(); cx.arc(x, y, 0.9 + wave * 1.1 + pull * 2.2, 0, Math.PI * 2); cx.fill();
          if (!pIn && !z && d < 95) near.push([x, y, d]);
        }
      }
      cx.strokeStyle = C_ACC; cx.lineWidth = 1;
      for (const [x, y, d] of near) {
        cx.globalAlpha = (1 - d / 95) * 0.35;
        cx.beginPath(); cx.moveTo(px, py); cx.lineTo(x, y); cx.stroke();
      }
      cx.globalAlpha = 1;
    };
    const loop = (t: number) => { if (run) draw(t); requestAnimationFrame(loop); };

    size(); draw(0);
    window.addEventListener("resize", () => { size(); draw(performance.now()); });
    if (!reduce) {
      requestAnimationFrame(loop);
      window.addEventListener("pointermove", (e) => {
        const r = cv.getBoundingClientRect();
        px = e.clientX - r.left; py = e.clientY - r.top;
      }, { passive: true });
      document.addEventListener("pointerleave", () => { px = py = -999; });
      new IntersectionObserver((es) => { run = es[0]?.isIntersecting ?? true; }).observe(cv);
    }
  }
</script>
